{
  "name": "portfolio-holding",
  "private": true,
  "type": "module",
  "imports": {
    "#portfolio/*": "./*"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch scripts/node-server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "start": "node scripts/node-server.ts",
    "api": "node scripts/node-server.ts",
    "dashboard": "node scripts/build.ts --dashboard",
    "build": "node scripts/build.ts",
    "agent:run": "node scripts/agent-runner.ts",
    "seed": "node scripts/seed.ts",
    "migrate": "node scripts/migrate.ts",
    "smoke": "node scripts/smoke.ts",
    "typecheck": "tsc -p tsconfig.check.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm test && npm run build && npm run smoke"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "clsx": "^2.1.1",
    "hono": "^4.13.14",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.7.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "drizzle-orm": "^0.45.4",
    "esbuild": "^0.25.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.4"
  }
}
