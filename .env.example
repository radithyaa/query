# Salin menjadi `.env` lalu sesuaikan. Jangan commit `.env`.

# --- Database lokal ---------------------------------------------------------
# SQLite untuk runtime Node + skrip. Kosongkan untuk memakai `.data/portfolio.db`.
LOCAL_DB_PATH=.data/portfolio.db

# --- Mode data --------------------------------------------------------------
# `true` = konektor mock deterministik, tidak ada panggilan keluar (lokal/staging).
MOCK_CONNECTORS=true

# --- HTTP -------------------------------------------------------------------
PORT=8787
APP_NAME=Portfolio Holding

# --- Keamanan ---------------------------------------------------------------
# Wajib diisi ≥16 karakter di staging/produksi (token layanan + tautan persetujuan).
JWT_SECRET=dev-only-secret-change-me-please
# TTL permintaan persetujuan (jam). FR-9.3: kedaluwarsa = tidak dijalankan.
APPROVAL_TTL_JAM=72

# --- Cloudflare Access (JWT RS256/ES256 via JWKS) ---------------------------
# ACCESS_ISSUER=https://tim-anda.cloudflareaccess.com
# ACCESS_AUDIENCE=<aud-tag>
# ACCESS_JWKS_URL=https://tim-anda.cloudflareaccess.com/cdn-cgi/access/certs

# --- Model ------------------------------------------------------------------
# Kosong = model mock deterministik (tanpa biaya). Isi untuk memakai Anthropic API.
# ANTHROPIC_API_KEY=

# --- Notifikasi -------------------------------------------------------------
NOTIFICATION_CHANNEL=log
